        <mxCell id="ik" value="&lt;b&gt;逆運動学（DLS）&lt;/b&gt;＋最小躍度補間&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Δq = Jᵀ(JJᵀ+λ²I)⁻¹e、50Hz&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;src/ik.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="260" width="250" height="90" as="geometry" />
