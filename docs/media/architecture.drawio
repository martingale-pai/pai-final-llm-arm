          <mxGeometry x="880" y="400" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="disturb" value="&lt;b&gt;外乱&lt;/b&gt;&lt;br&gt;運搬中に物体を落とす" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;" vertex="1" parent="1">
