<mxfile host="drawio" version="24.0.0">
  <diagram id="arch" name="アーキテクチャ">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- タイトル -->
        <mxCell id="title" value="&lt;b&gt;システム構成&lt;/b&gt;：LLM は「何をするか（What）」、検証済みスキルは「どう動くか（How）」" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- レイヤ枠 -->
        <mxCell id="layerAI" value="AI 層（言語 → 計画・検証）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#1D4ED8;" vertex="1" parent="1">
          <mxGeometry x="270" y="60" width="560" height="470" as="geometry" />
        </mxCell>
        <mxCell id="layerCtrl" value="制御層（スキル → 関節）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="850" y="60" width="310" height="470" as="geometry" />
        </mxCell>
        <mxCell id="layerOut" value="ログ・評価" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="270" y="560" width="890" height="170" as="geometry" />
        </mxCell>

        <!-- 入力 -->
        <mxCell id="instr" value="&lt;b&gt;日本語の指示&lt;/b&gt;&lt;br&gt;例「机の上を片付けて」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="state" value="&lt;b&gt;シーン状態（JSON）&lt;/b&gt;&lt;br&gt;物体の位置・大きさ・色&lt;br&gt;認識誤差 σ=3mm を付加" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="230" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- AI 層 -->
        <mxCell id="planner" value="&lt;b&gt;Planner&lt;/b&gt;（Gemini 3.5 Flash）&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;構造化出力（Pydantic スキーマ）&lt;br&gt;feasible / reasoning / plan / goal&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;src/planner.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="validator" value="&lt;b&gt;Validator&lt;/b&gt;（実行前）&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;存在しない ID・引数・&lt;br&gt;前提条件を記号的に検査&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;src/validator.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="verifier" value="&lt;b&gt;Verifier&lt;/b&gt;（実行後）&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;成功条件を述語で判定&lt;br&gt;in / on / on_table / holding&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;src/verifier.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="600" y="400" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="refuse" value="feasible=false&lt;br&gt;→ 実行を拒否" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="replan" value="&lt;b&gt;再計画（最大 3 回）&lt;/b&gt;&lt;br&gt;失敗理由＋最新の状態を&lt;br&gt;履歴として Planner に返す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;dashed=1;fontSize=12;fontColor=#B91C1C;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="190" height="80" as="geometry" />
